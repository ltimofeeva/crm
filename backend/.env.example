# Скопируйте этот файл в .env и вставьте свой ключ.
# Ключ берётся в консоли Claude: https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=sk-ant-впишите-сюда-ваш-ключ
PORT=8787
# Модель. Актуальный дефолт на июль 2026 — claude-opus-4-8 (самая умная из Opus).
# Если хочется дешевле — впишите claude-sonnet-5.
CLAUDE_MODEL=claude-opus-4-8
